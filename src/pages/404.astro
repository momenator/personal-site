---
import Layout from '@/layouts/Layout.astro';
---

<Layout title="404 — M.R">
  <div class="min-h-screen pt-28 md:pt-36 pb-24 px-6 md:px-12 max-w-7xl mx-auto">
    <div class="space-y-12">
      <header class="space-y-6">
        <span class="label-stark">Error</span>
        <h1 class="text-display-xl font-display text-monumental">404</h1>
        <div class="w-16 h-px bg-foreground/20"></div>
      </header>

      <div class="max-w-md space-y-6">
        <p class="text-xl text-light leading-snug tracking-tight text-grey-500">
          This page does not exist.
        </p>
        <a
          href="/"
          class="inline-block text-xs tracking-[0.15em] text-foreground border-b border-foreground pb-px hover:text-grey-500 hover:border-grey-500 transition-colors"
        >
          RETURN HOME
        </a>
      </div>
    </div>
  </div>
</Layout>
