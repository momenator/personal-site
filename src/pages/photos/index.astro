---
import Layout from '@/layouts/Layout.astro';
import { getCollection } from 'astro:content';

const photos = await getCollection('photos');
---

<Layout title="Photos — M.R">
  <div class="min-h-screen pt-28 md:pt-36 pb-24 px-6 md:px-12 max-w-7xl mx-auto">
    <div class="space-y-20 md:space-y-28">
      <!-- Header -->
      <header class="space-y-6">
        <span class="label-stark">Photography</span>
      </header>

      <!-- Photo grid - asymmetric masonry style -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-16 max-w-5xl">
        {photos.map((photo, index) => (
          <a
            href={`/photos/${photo.slug}`}
            class="group block"
          >
            <!-- Image container -->
            <div class="aspect-[4/3] bg-grey-100 overflow-hidden mb-5 transition-opacity group-hover:opacity-80">
              {photo.data.image ? (
                <img
                  src={photo.data.image}
                  alt={photo.data.title}
                  class="w-full h-full object-cover"
                />
              ) : (
                <div class="w-full h-full flex items-center justify-center">
                  <span class="text-xs font-mono text-grey-300 tracking-widest">[IMAGE]</span>
                </div>
              )}
            </div>

            <!-- Caption -->
            <div class="flex items-start justify-between gap-4">
              <div class="space-y-1">
                <h3 class="text-base font-medium tracking-tight">{photo.data.title}</h3>
                <p class="text-xs text-grey-400">{photo.data.description}</p>
              </div>
              <span class="text-[10px] font-mono text-grey-300 pt-1">{photo.data.year}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</Layout>
