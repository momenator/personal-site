---
import Layout from '@/layouts/Layout.astro';
import { getCollection } from 'astro:content';
import PhotoLightbox from '@/components/PhotoLightbox';

export async function getStaticPaths() {
  const photos = await getCollection('photos');
  return photos.map((photo) => ({
    params: { id: photo.slug },
    props: { photo, allPhotos: photos },
  }));
}

const { photo, allPhotos } = Astro.props;
const { Content } = await photo.render();
const relatedPhotos = allPhotos.filter((p) => p.slug !== photo.slug).slice(0, 4);
---

<Layout title={`${photo.data.title} — M.R`}>
  <div class="min-h-screen pt-32 pb-20 px-6 md:px-12 max-w-7xl mx-auto">
    <div class="space-y-12">
      <a
        href="/photos"
        class="inline-flex items-center gap-2 text-sm font-mono hover:translate-x-[-2px] transition-transform"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m12 19-7-7 7-7"/><path d="M19 12H5"/>
        </svg>
        BACK TO PHOTOS
      </a>

      <div class="space-y-8 max-w-5xl">
        <div class="space-y-4">
          <div class="flex items-start justify-between flex-wrap gap-4">
            <h1 class="text-4xl md:text-6xl font-bold tracking-tighter">
              {photo.data.title}
            </h1>
            <span class="text-lg text-grey-500 font-mono">{photo.data.year}</span>
          </div>
          <div class="w-20 h-1 bg-foreground"></div>
        </div>

        {photo.data.image ? (
          <PhotoLightbox src={photo.data.image} alt={photo.data.title} client:load />
        ) : (
          <div class="aspect-[3/2] bg-grey-200 border-2 border-foreground overflow-hidden">
            <div class="w-full h-full flex items-center justify-center text-grey-400">
              <span class="text-lg font-mono">[{photo.data.title.toUpperCase()}]</span>
            </div>
          </div>
        )}

        <div class="grid md:grid-cols-3 gap-8 border-2 border-foreground p-8">
          <div class="space-y-2">
            <h3 class="text-xs font-mono text-grey-500 uppercase tracking-wider">Location</h3>
            <p class="text-lg font-bold">{photo.data.location}</p>
          </div>
          <div class="space-y-2">
            <h3 class="text-xs font-mono text-grey-500 uppercase tracking-wider">Camera</h3>
            <p class="text-lg font-bold">{photo.data.camera}</p>
          </div>
          <div class="space-y-2">
            <h3 class="text-xs font-mono text-grey-500 uppercase tracking-wider">Year</h3>
            <p class="text-lg font-bold">{photo.data.year}</p>
          </div>
        </div>

        <div class="space-y-4">
          <h2 class="text-2xl font-bold">About This Photo</h2>
          <div class="text-lg text-grey-600 leading-relaxed">
            <Content />
          </div>
        </div>

        <div class="border-t-2 border-foreground pt-8">
          <h3 class="text-sm font-mono text-grey-500 uppercase tracking-wider mb-4">
            More photos
          </h3>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            {relatedPhotos.map((p) => (
              <a href={`/photos/${p.slug}`} class="group">
                <div class="aspect-square bg-grey-200 border-2 border-foreground overflow-hidden brutalist-hover">
                  {p.data.image ? (
                    <img
                      src={p.data.image}
                      alt={p.data.title}
                      class="w-full h-full object-cover"
                    />
                  ) : (
                    <div class="w-full h-full flex items-center justify-center text-grey-400">
                      <span class="text-xs font-mono">[IMG]</span>
                    </div>
                  )}
                </div>
                <p class="text-xs font-mono mt-2">{p.data.title}</p>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
