---
import Layout from '@/layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('writing');
posts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---

<Layout title="Writing — M.R">
  <div class="min-h-screen pt-28 md:pt-36 pb-24 px-6 md:px-12 max-w-7xl mx-auto">
    <div class="space-y-20 md:space-y-28">
      <!-- Header -->
      <header class="space-y-6">
        <span class="label-stark">Writing</span>
      </header>

      <!-- Post list -->
      <div class="max-w-3xl">
        {posts.map((post, index) => (
          <a
            href={`/writing/${post.slug}`}
            class="group block border-t border-foreground/10 py-10 md:py-14 transition-colors hover:bg-foreground/[0.02]"
          >
            <article class="grid grid-cols-12 gap-4 md:gap-8">
              <!-- Index -->
              <div class="col-span-2 md:col-span-1">
                <span class="font-mono text-xs text-grey-300">
                  {String(index + 1).padStart(2, '0')}
                </span>
              </div>

              <!-- Content -->
              <div class="col-span-10 md:col-span-8 space-y-3">
                <h2 class="text-lg md:text-xl font-medium tracking-tight group-hover:opacity-70 transition-opacity">
                  {post.data.title}
                </h2>
                <p class="text-sm text-grey-400 leading-relaxed">
                  {post.data.excerpt}
                </p>
              </div>

              <!-- Meta -->
              <div class="col-span-12 md:col-span-3 flex md:flex-col gap-3 md:gap-1 md:items-end md:text-right pt-2 md:pt-0">
                <time class="text-xs font-mono text-grey-300">{post.data.date}</time>
                <span class="text-xs font-mono text-grey-300">{post.data.readTime}</span>
              </div>
            </article>
          </a>
        ))}
        <!-- Bottom border -->
        <div class="border-t border-foreground/10"></div>
      </div>
    </div>
  </div>
</Layout>
