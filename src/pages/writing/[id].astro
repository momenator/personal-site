---
import Layout from '@/layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('writing');
  return posts.map((post) => ({
    params: { id: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
---

<Layout title={`${post.data.title} — M.R`}>
  <div class="min-h-screen pt-32 pb-20 px-6 md:px-12 max-w-7xl mx-auto">
    <a
      href="/writing"
      class="inline-flex items-center gap-2 text-sm hover:text-grey-500 transition-colors mb-12"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m12 19-7-7 7-7"/><path d="M19 12H5"/>
      </svg>
      BACK TO WRITING
    </a>

    <article class="max-w-3xl space-y-12">
      <!-- Header -->
      <header class="space-y-6">
        <h1 class="text-4xl md:text-6xl font-bold tracking-tight leading-tight">
          {post.data.title}
        </h1>
        <div class="flex items-center gap-4 text-sm text-grey-500 font-mono">
          <time>{post.data.date}</time>
          <span>•</span>
          <span>{post.data.readTime}</span>
        </div>
        <div class="w-20 h-1 bg-foreground"></div>
      </header>

      <!-- Markdown content -->
      <div class="prose-writing">
        <Content />
      </div>

      <!-- Footer -->
      <footer class="pt-12 mt-12 border-t-2 border-grey-300">
        <a
          href="/writing"
          class="inline-flex items-center gap-2 text-sm font-bold hover:text-grey-500 transition-colors"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m12 19-7-7 7-7"/><path d="M19 12H5"/>
          </svg>
          READ MORE
        </a>
      </footer>
    </article>
  </div>
</Layout>
