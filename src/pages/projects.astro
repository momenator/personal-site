---
import Layout from '@/layouts/Layout.astro';

const projects = [
  {
    title: "Project Alpha",
    year: "2024",
    description: "A brutalist approach to modern web design",
    tech: ["React", "TypeScript", "Tailwind"],
  },
  {
    title: "Project Beta",
    year: "2024",
    description: "Minimalist e-commerce platform",
    tech: ["Next.js", "Supabase", "Stripe"],
  },
  {
    title: "Project Gamma",
    year: "2023",
    description: "Portfolio management system",
    tech: ["React", "Node.js", "PostgreSQL"],
  },
];
---

<Layout title="Projects — M.R">
  <div class="min-h-screen pt-28 md:pt-36 pb-24 px-6 md:px-12 max-w-7xl mx-auto">
    <div class="space-y-20 md:space-y-28">
      <!-- Header -->
      <header class="space-y-6">
        <span class="label-stark">Projects</span>
      </header>

      <!-- Project list - Architectural divider style -->
      <div class="max-w-4xl">
        {projects.map((project, index) => (
          <div class="group border-t border-foreground/10 py-10 md:py-14 cursor-pointer transition-colors hover:bg-foreground/[0.02]">
            <div class="grid grid-cols-12 gap-4 md:gap-8 items-start">
              <!-- Index number -->
              <div class="col-span-2 md:col-span-1">
                <span class="font-mono text-xs text-grey-300">
                  {String(index + 1).padStart(2, '0')}
                </span>
              </div>

              <!-- Content -->
              <div class="col-span-10 md:col-span-7 space-y-3">
                <h2 class="text-xl md:text-2xl font-medium tracking-tight group-hover:opacity-70 transition-opacity">
                  {project.title}
                </h2>
                <p class="text-sm text-grey-400 leading-relaxed">
                  {project.description}
                </p>
              </div>

              <!-- Meta -->
              <div class="col-span-12 md:col-span-4 flex flex-wrap gap-x-4 gap-y-2 md:justify-end items-start pt-2 md:pt-0">
                <span class="text-xs font-mono text-grey-400">{project.year}</span>
                <div class="flex flex-wrap gap-2">
                  {project.tech.map((tech) => (
                    <span class="text-[10px] font-mono uppercase tracking-widest text-grey-300">
                      {tech}
                    </span>
                  ))}
                </div>
              </div>
            </div>
          </div>
        ))}
        <!-- Bottom border -->
        <div class="border-t border-foreground/10"></div>
      </div>
    </div>
  </div>
</Layout>
